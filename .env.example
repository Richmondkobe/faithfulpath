# The settings the site needs, names only. Copy to .env.local and fill in the
# values (Vercel holds the production ones). Never commit real values.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MEMBERSHIP_PRICE_ID=

# Email: MailerLite (newsletter), Resend (sign-in codes and messages)
MAILERLITE_API_KEY=
RESEND_API_KEY=
RESEND_FROM=

# Book claim links
GUIDE_CLAIM_SECRET=

# The site's own address, for links in emails
NEXT_PUBLIC_SITE_URL=
