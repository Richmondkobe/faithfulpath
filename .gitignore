# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# course recordings — these live in the private Supabase bucket, never in git
*.mp4
*.mp3

# Slide-lecture pilot pages. Each one is the working player for a lesson and is
# the source of truth for that lesson's slides and timings — but it carries its
# own mp3 embedded as base64, so the twenty-one of them come to 234 MB. They
# stay on disk and out of git; what gets committed is the slides.json extracted
# from them.
pilot.html
*-pilot-page.html

# Reviewer packs — rounds of review, superseded by the pilot pages themselves.
*-Pilot-Review-Pack.pdf

# Supabase CLI scratch — written by `supabase link`, holds the linked
# project ref and a pooler connection string. Not ours to commit.
supabase/.temp/
